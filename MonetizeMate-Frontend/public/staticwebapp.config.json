{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/api/*",
      "/*.{png,jpg,gif,svg,ico,css,js,woff,woff2}"
    ]
  },
  "routes": [
    {
      "route": "/_next/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/login",
      "rewrite": "/login"
    },
    {
      "route": "/signup",
      "rewrite": "/signup"
    },
    {
      "route": "/dashboard/*",
      "rewrite": "/dashboard"
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}