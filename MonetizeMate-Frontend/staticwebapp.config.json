{
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/_next/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/",
    "exclude": [
      "/api/*",
      "/_next/*",
      "/*.ico",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.json",
      "/*.css",
      "/*.js"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/",
      "statusCode": 200
    }
  }
}